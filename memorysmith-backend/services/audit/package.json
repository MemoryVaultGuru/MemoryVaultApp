{
  "name": "@memorysmith/svc-audit",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Audit bounded context: the append-only trail. Consumer of every event of the bus, and the one service whose immutability is enforced by IAM rather than by code.",
  "exports": {
    "./domain": "./src/domain/index.ts",
    "./application": "./src/application/index.ts",
    "./adapters/trail": "./src/adapters/outbound/DynamoAuditTrail.ts",
    "./adapters/content": "./src/adapters/outbound/S3RevisionReader.ts",
    "./adapters/http": "./src/adapters/inbound/routes.ts",
    "./adapters/consumer": "./src/adapters/inbound/event-consumer.ts",
    "./main": "./src/main/handler.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1117.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.1117.0",
    "@memorysmith/contracts": "workspace:*",
    "@memorysmith/kernel": "workspace:*",
    "hono": "^4.9.0"
  }
}
